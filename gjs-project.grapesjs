 create exceptional digital experiences."}]},{"tagName":"p","type":"text","classes":["about-paragraph-2"],"components":[{"type":"textnode","content":"Our approach combines strategic thinking with creative excellence and technical expertise. We believe in building long-term partnerships with our clients, understanding their unique challenges, and delivering solutions that drive real business results."}]},{"tagName":"p","type":"text","classes":["about-paragraph-3"],"components":[{"type":"textnode","content":"With over 200 successful projects delivered and a 98% client retention rate, we're proud to be trusted by startups and Fortune 500 companies alike. Our team of 30+ experts brings diverse perspectives and specialized skills to every project."}]},{"classes":["about-stats"],"components":[{"components":[{"tagName":"h3","type":"heading","classes":["stat-number-1"],"components":[{"type":"textnode","content":"200+"}]},{"tagName":"p","type":"text","classes":["stat-label-1"],"components":[{"type":"textnode","content":"Projects Delivered"}]}]},{"components":[{"tagName":"h3","type":"heading","classes":["stat-number-2"],"components":[{"type":"textnode","content":"98%"}]},{"tagName":"p","type":"text","classes":["stat-label-2"],"components":[{"type":"textnode","content":"Client Retention"}]}]},{"components":[{"tagName":"h3","type":"heading","classes":["stat-number-3"],"components":[{"type":"textnode","content":"30+"}]},{"tagName":"p","type":"text","classes":["stat-label-3"],"components":[{"type":"textnode","content":"Team Members"}]}]}]}]},{"classes":["about-image-container"],"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["about-image"],"attributes":{"src":"https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80","alt":"Team members collaborating in modern office space"}}]}]}]}]},{"type":"comment","content":" Testimonials Section "},{"tagName":"section","classes":["testimonials-section"],"attributes":{"id":"testimoni